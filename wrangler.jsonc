{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "g-clin-maria",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/server.js",
  "assets": {
    "directory": "./dist/client"
  },
  // Preencha com os valores do projeto Supabase Cloud quando for fazer o deploy.
  // Nao use aqui as chaves de local dev (.env) — configure via `wrangler secret put`
  // para valores sensiveis, e `vars` abaixo apenas para os publicos (URL, anon key).
  "vars": {
    "VITE_SUPABASE_URL": "",
    "VITE_SUPABASE_PUBLISHABLE_KEY": ""
  }
}
